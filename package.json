{
  "name": "cc-changelog-tracker",
  "version": "1.0.0",
  "description": "定時偵測 Claude Code CHANGELOG 新版本, 分類翻譯後通知 Discord",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/index.ts",
    "check": "node src/index.ts --once",
    "notify-latest": "node src/index.ts --notify-latest",
    "docs": "node scripts/build-docs.ts",
    "typecheck": "tsc",
    "test": "node --test \"test/**/*.test.ts\""
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.310",
    "@google/genai": "^2.31.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "pele": "^1.9.0",
    "typescript": "^7.0.2"
  }
}
